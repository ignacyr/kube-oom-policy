{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["image", "imagePullSecrets", "oomGroup", "nodeSelector", "nodeSelectorExpressions", "tolerations", "podSelector", "namespaces", "podNames", "containerNames", "excludedContainerNames", "pollInterval", "resources"],
  "properties": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "tag", "digest", "pullPolicy"],
      "properties": {
        "repository": {"type": "string", "pattern": "^\\S+$"},
        "tag": {"type": "string", "minLength": 1},
        "digest": {"type": "string", "pattern": "^$|^sha256:[a-f0-9]{64}$"},
        "pullPolicy": {"enum": ["Always", "IfNotPresent", "Never"]}
      }
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": {"name": {"$ref": "#/definitions/dnsSubdomain"}}
      }
    },
    "oomGroup": {"type": "boolean"},
    "nodeSelector": {
      "type": "object",
      "required": ["kubernetes.io/os"],
      "properties": {"kubernetes.io/os": {"const": "linux"}},
      "propertyNames": {"$ref": "#/definitions/labelKey"},
      "additionalProperties": {"$ref": "#/definitions/labelValue"}
    },
    "nodeSelectorExpressions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "operator"],
        "properties": {
          "key": {"$ref": "#/definitions/labelKey"},
          "operator": {"enum": ["In", "NotIn", "Exists", "DoesNotExist"]},
          "values": {
            "type": "array",
            "uniqueItems": true,
            "items": {"$ref": "#/definitions/labelValue"}
          }
        },
        "oneOf": [
          {
            "properties": {"operator": {"enum": ["In", "NotIn"]}, "values": {"minItems": 1}},
            "required": ["values"]
          },
          {
            "properties": {"operator": {"enum": ["Exists", "DoesNotExist"]}, "values": {"maxItems": 0}}
          }
        ]
      }
    },
    "tolerations": {"type": "array", "items": {"type": "object"}},
    "podSelector": {"type": "string", "pattern": "\\S"},
    "namespaces": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/definitions/dnsLabel"}},
    "podNames": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/definitions/dnsSubdomain"}},
    "containerNames": {"$ref": "#/definitions/containerNames"},
    "excludedContainerNames": {"$ref": "#/definitions/containerNames"},
    "pollInterval": {
      "type": "string",
      "description": "Whole seconds or minutes between 1s and 1h.",
      "pattern": "^(([1-9]|[1-9][0-9]{1,2}|[12][0-9]{3}|3[0-5][0-9]{2}|3600)s|([1-9]|[1-5][0-9]|60)m|1h)$"
    },
    "resources": {"type": "object"}
  },
  "definitions": {
    "dnsLabel": {"type": "string", "maxLength": 63, "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"},
    "dnsSubdomain": {"type": "string", "maxLength": 253, "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$"},
    "labelKey": {
      "type": "string",
      "maxLength": 317,
      "pattern": "^(([a-z0-9]([-a-z0-9]*[a-z0-9])?\\.)*[a-z0-9]([-a-z0-9]*[a-z0-9])?/)?[A-Za-z0-9]([-A-Za-z0-9_.]*[A-Za-z0-9])?$"
    },
    "labelValue": {"type": "string", "maxLength": 63, "pattern": "^([A-Za-z0-9]([-A-Za-z0-9_.]*[A-Za-z0-9])?)?$"},
    "containerNames": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/definitions/dnsLabel"}}
  }
}
